rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        ((request.auth.token.email == 'ceganigabriel@gmail.com' || request.auth.token.email == 'bunnicula646@gmail.com') && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Connection testing doc
    match /test/connection {
      allow read: if true;
    }

    // Admin Access Records
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // User & Chef Profiles
    match /users/{userId} {
      allow read: if true;
      allow create: if (isOwner(userId) || isAdmin())
        && incoming().id == userId
        && incoming().displayName is string
        && incoming().displayName.size() > 0
        && incoming().displayName.size() <= 100;
      allow update: if isAdmin()
        || (isOwner(userId)
            && incoming().id == existing().id
            && incoming().role == existing().role
            && (!('accountStatus' in incoming()) || incoming().accountStatus == existing().get('accountStatus', 'active') || incoming().accountStatus == 'pending_deletion'))
        || (isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['ratingAverage', 'ratingCount', 'subscriberCount', 'followerCount']));
      allow delete: if isAdmin();

      // User bookmarked recipe favourites
      match /favourites/{favouriteId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if (isOwner(userId) || isAdmin())
          && incoming().userId == userId
          && isValidId(incoming().recipeId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      // User bookmarked video favourites
      match /video_favourites/{videoFavId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if (isOwner(userId) || isAdmin())
          && incoming().userId == userId
          && isValidId(incoming().videoId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      // User notifications
      match /notifications/{notificationId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isSignedIn();
        allow update: if isOwner(userId) || isAdmin();
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    // Recipes
    match /recipes/{recipeId} {
      allow read: if true;
      allow create: if isSignedIn()
        && (isAdmin() || incoming().authorId == request.auth.uid)
        && incoming().title is string && incoming().title.size() > 0 && incoming().title.size() <= 150
        && incoming().category is string
        && incoming().cuisine is string;
      allow update: if isSignedIn()
        && (
          isAdmin()
          // Chef author update
          || (existing().authorId == request.auth.uid && incoming().authorId == existing().authorId)
          // Or rating/likes update by users
          || (incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'ratingAverage', 'ratingCount']))
        );
      allow delete: if isSignedIn() && (isAdmin() || existing().authorId == request.auth.uid);

      // Recipe Comments
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn()
          && incoming().userId == request.auth.uid
          && incoming().content is string && incoming().content.size() > 0 && incoming().content.size() <= 2000;
        allow delete: if isSignedIn() && (isAdmin() || existing().userId == request.auth.uid);
      }
    }

    // Cooking Videos
    match /videos/{videoId} {
      allow read: if true;
      allow create: if isSignedIn()
        && (isAdmin() || incoming().authorId == request.auth.uid)
        && incoming().title is string && incoming().title.size() > 0 && incoming().title.size() <= 150
        && incoming().videoUrl is string;
      allow update: if isSignedIn()
        && (
          isAdmin()
          || (existing().authorId == request.auth.uid && incoming().authorId == existing().authorId)
          || (incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'viewCount']))
        );
      allow delete: if isSignedIn() && (isAdmin() || existing().authorId == request.auth.uid);

      // Video Comments
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn()
          && incoming().userId == request.auth.uid
          && incoming().content is string && incoming().content.size() > 0 && incoming().content.size() <= 2000;
        allow delete: if isSignedIn() && existing().userId == request.auth.uid;
      }

      // Universal Video Chunks for Cross-Device Playback
      match /chunks/{chunkId} {
        allow read: if true;
        allow create, update: if isSignedIn();
        allow delete: if isSignedIn();
      }
    }

    // Subscriptions
    match /subscriptions/{subscriptionId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || resource.data.chefId == request.auth.uid);
      allow create: if isSignedIn()
        && incoming().userId == request.auth.uid
        && isValidId(incoming().chefId);
      allow update: if isSignedIn()
        && existing().userId == request.auth.uid;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Chef Communities and Settings
    match /communities/{chefId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(chefId);

      // VIP Community Messages
      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && incoming().senderId == request.auth.uid
          && incoming().text is string && incoming().text.size() > 0 && incoming().text.size() <= 1000;
        allow delete: if isSignedIn() && (existing().senderId == request.auth.uid || chefId == request.auth.uid);
      }
    }

    // Chef Reviews & Ratings
    match /chefs/{chefId}/reviews/{reviewId} {
      allow read: if true;
      allow create, update: if isSignedIn() && incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Customer Support Tickets (private to ticket owner or admin)
    match /support_tickets/{ticketId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if true;
      allow update: if isAdmin();
    }

    // Live Support Chat Messages
    match /support_chats/{chatId}/messages/{messageId} {
      allow read, create: if true;
    }

    // Community Reports (private to reporter or admin)
    match /community_reports/{reportId} {
      allow read: if isSignedIn() && (resource.data.reportedByUserId == request.auth.uid || resource.data.reportedBy == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Masterclass Registrations
    match /masterclass_registrations/{registrationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Shopping Lists
    match /shopping_lists/{listId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Cooking Challenges
    match /challenges/{challengeId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if false;
    }

    // Challenge Entries
    match /challenge_entries/{entryId} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && (existing().userId == request.auth.uid || incoming().diff(existing()).affectedKeys().hasOnly(['voteCount']));
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Challenge Votes
    match /challenge_votes/{voteId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // User Badges
    match /user_badges/{badgeId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if false;
    }

    // Immutable Legal Consent & Policy Acceptance Audit Records
    match /legal_acceptances/{acceptanceId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && isValidId(acceptanceId)
        && incoming().userId == request.auth.uid
        && incoming().termsVersion is string && incoming().termsVersion.size() <= 32
        && incoming().privacyPolicyVersion is string && incoming().privacyPolicyVersion.size() <= 32
        && incoming().communityGuidelinesVersion is string && incoming().communityGuidelinesVersion.size() <= 32
        && incoming().status in ['accepted', 'declined']
        && incoming().registrationMethod is string && incoming().registrationMethod.size() <= 64;
      allow update, delete: if false;
    }

    // Copyright & Creator Protection Claims (Private to claimant/affected author & admins)
    match /copyright_claims/{claimId} {
      allow read: if isSignedIn() && (
        resource.data.claimantUserId == request.auth.uid ||
        resource.data.targetAuthorId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn()
        && isValidId(claimId)
        && incoming().claimantUserId == request.auth.uid
        && incoming().claimantName is string && incoming().claimantName.size() > 0 && incoming().claimantName.size() <= 120
        && incoming().claimantEmail is string && incoming().claimantEmail.size() > 0 && incoming().claimantEmail.size() <= 160
        && incoming().violationType is string && incoming().violationType.size() <= 64
        && incoming().reportedTargetType is string && incoming().reportedTargetType.size() <= 64
        && incoming().originalWorkDescription is string && incoming().originalWorkDescription.size() >= 10 && incoming().originalWorkDescription.size() <= 3000
        && incoming().goodFaithDeclaration == true
        && incoming().status == 'submitted';
      allow update: if isSignedIn() && (
        isAdmin() ||
        (existing().targetAuthorId == request.auth.uid
          && incoming().diff(existing()).affectedKeys().hasOnly(['counterNoticeText', 'counterNoticeAt', 'status', 'updatedAt'])
          && incoming().status == 'counter_notice_submitted'
          && incoming().counterNoticeText is string
          && incoming().counterNoticeText.size() >= 10
          && incoming().counterNoticeText.size() <= 3000)
      );
      allow delete: if isAdmin();
    }

    // Unified Content & User Safety Moderation Reports (Private to reporter & admins)
    match /moderation_reports/{reportId} {
      allow read: if isSignedIn() && (resource.data.reporterId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && isValidId(reportId)
        && incoming().reporterId == request.auth.uid
        && incoming().targetType is string && incoming().targetType.size() <= 64
        && incoming().targetId is string && incoming().targetId.size() <= 128
        && incoming().reason is string && incoming().reason.size() <= 100
        && incoming().details is string && incoming().details.size() <= 3000
        && incoming().status == 'pending';
      allow update, delete: if isAdmin();
    }

    // Moderation Appeals (Private to appellant user & admins)
    match /moderation_appeals/{appealId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && isValidId(appealId)
        && incoming().userId == request.auth.uid
        && incoming().targetId is string && incoming().targetId.size() <= 128
        && incoming().appealReason is string && incoming().appealReason.size() >= 10 && incoming().appealReason.size() <= 3000
        && incoming().status == 'pending';
      allow update, delete: if isAdmin();
    }

    // User Block List (Strictly private to blocker & admins)
    match /blocked_users/{blockId} {
      allow read: if isSignedIn() && (resource.data.blockerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && isValidId(blockId)
        && incoming().blockerId == request.auth.uid
        && isValidId(incoming().blockedUserId);
      allow delete: if isSignedIn() && (existing().blockerId == request.auth.uid || isAdmin());
      allow update: if false;
    }

    // Account Deletion & Privacy Data Rights Requests (Private to requester & admins)
    match /privacy_requests/{requestId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && isValidId(requestId)
        && incoming().userId == request.auth.uid
        && incoming().requestType in ['account_deletion', 'data_access', 'data_correction', 'privacy_inquiry']
        && incoming().details is string && incoming().details.size() <= 3000
        && incoming().status == 'pending';
      allow update: if isSignedIn() && (
        isAdmin() ||
        (existing().userId == request.auth.uid
          && existing().status == 'pending'
          && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          && incoming().status == 'cancelled')
      );
      allow delete: if isAdmin();
    }

    // Immutable Administrative Audit Logs
    match /moderation_audit_logs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // Legal Policy Versions & Effective Dates
    match /policy_metadata/{policyId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
